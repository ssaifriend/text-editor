{
  "name": "moru",
  "version": "0.0.1",
  "private": true,
  "description": "Personal text editor: Sublime Text feel plus an agent terminal",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.test.json --composite false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@electron-toolkit/utils": "4.0.0",
    "@lezer/highlight": "1.2.3",
    "@mobily/ts-belt": "3.13.1",
    "@parcel/watcher": "2.6.0",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "chardet": "2.2.0",
    "dompurify": "3.4.15",
    "electron-log": "5.4.4",
    "fzf": "0.5.2",
    "iconv-lite": "0.7.3",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.1",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-footnote": "4.0.0",
    "morphdom": "2.7.8",
    "node-pty": "1.1.0",
    "solid-js": "1.9.15",
    "string-width": "8.2.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fast-check": "4.9.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  }
}

{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["tests/**/*", "src/preload/*.d.ts", "src/shared/**/*", "src/renderer/src/**/*.ts", "src/main/fs/**/*", "vitest.config.ts", "playwright.config.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
